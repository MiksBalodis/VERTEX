 290:USB_DEVICE/App/usbd_storage_if.c ****     /* Constants for clarity */
 291:USB_DEVICE/App/usbd_storage_if.c ****     #define BLOCK_SIZE 512
 292:USB_DEVICE/App/usbd_storage_if.c ****     #define SECTOR_SIZE 4096
 293:USB_DEVICE/App/usbd_storage_if.c ****     #define BLOCKS_PER_SECTOR (SECTOR_SIZE / BLOCK_SIZE)
 294:USB_DEVICE/App/usbd_storage_if.c ****     #define PAGE_SIZE 256
 295:USB_DEVICE/App/usbd_storage_if.c ****     #define PAGES_PER_SECTOR (SECTOR_SIZE / PAGE_SIZE)
 296:USB_DEVICE/App/usbd_storage_if.c **** 
 297:USB_DEVICE/App/usbd_storage_if.c ****     static uint8_t sector_buf[SECTOR_SIZE];
 298:USB_DEVICE/App/usbd_storage_if.c **** 
 299:USB_DEVICE/App/usbd_storage_if.c ****     uint32_t blocks_written = 0;
 300:USB_DEVICE/App/usbd_storage_if.c **** 
 301:USB_DEVICE/App/usbd_storage_if.c ****     while (blocks_written < blk_len)
 302:USB_DEVICE/App/usbd_storage_if.c ****     {
 303:USB_DEVICE/App/usbd_storage_if.c ****         /* Compute current sector */
 304:USB_DEVICE/App/usbd_storage_if.c ****         uint32_t sector = (blk_addr + blocks_written) / BLOCKS_PER_SECTOR;
 305:USB_DEVICE/App/usbd_storage_if.c ****         uint32_t sector_start_block = sector * BLOCKS_PER_SECTOR;
 306:USB_DEVICE/App/usbd_storage_if.c ****         uint32_t offset_in_sector = (blk_addr + blocks_written - sector_start_block) * BLOCK_SIZE;
 307:USB_DEVICE/App/usbd_storage_if.c **** 
 308:USB_DEVICE/App/usbd_storage_if.c ****         /* How many blocks fit in this sector */
 309:USB_DEVICE/App/usbd_storage_if.c ****         uint32_t blocks_in_this_sector = BLOCKS_PER_SECTOR - (blk_addr + blocks_written - sector_st
 310:USB_DEVICE/App/usbd_storage_if.c ****         if (blocks_in_this_sector > (blk_len - blocks_written))
 311:USB_DEVICE/App/usbd_storage_if.c ****             blocks_in_this_sector = blk_len - blocks_written;
 312:USB_DEVICE/App/usbd_storage_if.c **** 
 313:USB_DEVICE/App/usbd_storage_if.c ****         /* Read current sector from flash */
 314:USB_DEVICE/App/usbd_storage_if.c ****         MX25FLASH_Continious_Read(sector * SECTOR_SIZE, sector_buf, SECTOR_SIZE);
 315:USB_DEVICE/App/usbd_storage_if.c **** 
 316:USB_DEVICE/App/usbd_storage_if.c ****         /* Copy USB blocks into sector buffer */
 317:USB_DEVICE/App/usbd_storage_if.c ****         memcpy(sector_buf + offset_in_sector,
 318:USB_DEVICE/App/usbd_storage_if.c ****                buf + blocks_written * BLOCK_SIZE,
 319:USB_DEVICE/App/usbd_storage_if.c ****                blocks_in_this_sector * BLOCK_SIZE);
 320:USB_DEVICE/App/usbd_storage_if.c **** 
 321:USB_DEVICE/App/usbd_storage_if.c ****         /* Erase and program sector page by page */
 322:USB_DEVICE/App/usbd_storage_if.c ****         _MX25FLASH_Sector_Erase(sector);
 323:USB_DEVICE/App/usbd_storage_if.c ****         for (uint32_t page = 0; page < PAGES_PER_SECTOR; page++)
 324:USB_DEVICE/App/usbd_storage_if.c ****         {
 325:USB_DEVICE/App/usbd_storage_if.c ****             MX25FLASH_Program_Page(sector * PAGES_PER_SECTOR + page,
 326:USB_DEVICE/App/usbd_storage_if.c ****                                    sector_buf + page * PAGE_SIZE);
 327:USB_DEVICE/App/usbd_storage_if.c ****         }
 328:USB_DEVICE/App/usbd_storage_if.c **** 
 329:USB_DEVICE/App/usbd_storage_if.c ****         blocks_written += blocks_in_this_sector;
 330:USB_DEVICE/App/usbd_storage_if.c ****     }
 331:USB_DEVICE/App/usbd_storage_if.c **** 
 332:USB_DEVICE/App/usbd_storage_if.c ****     return USBD_OK;
 333:USB_DEVICE/App/usbd_storage_if.c ****   /* USER CODE END 7 */
 334:USB_DEVICE/App/usbd_storage_if.c **** }
