  45:Core/Src/25flash.c **** 
  46:Core/Src/25flash.c **** void MX25FLASH_Program_Page(uint16_t page, uint8_t data[256]){
  47:Core/Src/25flash.c **** 	MX25FLASH_WE();
  48:Core/Src/25flash.c ****     uint8_t tData[260];
  49:Core/Src/25flash.c **** 	uint32_t address = page * 0x100;
  50:Core/Src/25flash.c **** 	tData[0] = 0x02;
  51:Core/Src/25flash.c ****     tData[1] = (address >> 16) & 0xFF;  // Most significant byte
  52:Core/Src/25flash.c ****     tData[2] = (address >> 8) & 0xFF;
  53:Core/Src/25flash.c ****     tData[3] = address & 0xFF;          // Least significant byte
  54:Core/Src/25flash.c **** 	memcpy(&tData[4], data, 256); 
  55:Core/Src/25flash.c **** 	FLASH_CS_LOW();  // pull the CS LOW
  56:Core/Src/25flash.c ****     MX25FLASH_SPI_Write(tData, 260);
  57:Core/Src/25flash.c **** 	FLASH_CS_HIGH();  // pull the HIGH
  58:Core/Src/25flash.c **** 	MX25FLASH_WFE();
  59:Core/Src/25flash.c **** }
