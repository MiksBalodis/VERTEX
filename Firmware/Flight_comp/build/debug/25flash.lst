  68:Core/Src/25flash.c **** uint8_t MX25FLASH_Sector_Erase(uint32_t sector){
  69:Core/Src/25flash.c **** 	MX25FLASH_WE();
  70:Core/Src/25flash.c ****     uint8_t cmd[4];
  71:Core/Src/25flash.c ****     cmd[0] = 0x20;  // 4KB Sector Erase
  72:Core/Src/25flash.c ****     cmd[1] = (sector >> 16) & 0xFF;
  73:Core/Src/25flash.c ****     cmd[2] = (sector >> 8) & 0xFF;
  74:Core/Src/25flash.c ****     cmd[3] = sector & 0xFF;
  75:Core/Src/25flash.c **** 
