  77:Core/Src/25flash.c ****     MX25FLASH_SPI_Write(cmd, 4);
  78:Core/Src/25flash.c ****     FLASH_CS_HIGH();
  79:Core/Src/25flash.c **** 	return MX25FLASH_WFE();
